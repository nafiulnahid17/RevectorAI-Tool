REVECTOR_DATA_DIR=./data
REVECTOR_MAX_UPLOAD_BYTES=52428800
REVECTOR_MAX_PIXELS=40000000
REVECTOR_WORKER_THREADS=2
REVECTOR_SYNC_JOBS=false
REVECTOR_TOOL_TIMEOUT_SECONDS=180
REVECTOR_MAX_PATHS=100000
REVECTOR_STORAGE_BACKEND=local
REVECTOR_SEGMENTATION_PROVIDER=opencv
REVECTOR_OCR_PROVIDER=tesseract
