REVECTOR_DATA_DIR=./data
REVECTOR_MAX_UPLOAD_BYTES=52428800
REVECTOR_MAX_PIXELS=40000000
REVECTOR_WORKER_THREADS=2
REVECTOR_SYNC_JOBS=false
REVECTOR_TOOL_TIMEOUT_SECONDS=180
REVECTOR_MAX_PATHS=100000
REVECTOR_STORAGE_BACKEND=local
REVECTOR_SEGMENTATION_PROVIDER=opencv
REVECTOR_OCR_PROVIDER=tesseract
REVECTOR_JOB_TIMEOUT_SECONDS=1800

# Trusted gateway authentication.
REVECTOR_API_KEY=
REVECTOR_ALLOW_UNAUTHENTICATED=false

# Standard AI production setup: this is the only required AI credential.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
REVECTOR_AI_PROFILE=production
AI_TIMEOUT_SECONDS=120

# Optional per-operation model overrides. Blank = built-in production profile.
ANALYZE_MODEL=
IDENTIFY_MODEL=
ENHANCE_MODEL=
MOCKUP_MODEL=
MOCKUP_QC_MODEL=
MISSING_PART_MODEL=
ERROR_MODEL=

ANALYZE_FALLBACK_MODEL=
IDENTIFY_FALLBACK_MODEL=
ENHANCE_FALLBACK_MODEL=
MOCKUP_FALLBACK_MODEL=
MOCKUP_QC_FALLBACK_MODEL=
MISSING_PART_FALLBACK_MODEL=
ERROR_FALLBACK_MODEL=

# Global rolling fallback allowance shared by all operations.
FALLBACK_MAX_CALLS=2
FALLBACK_WINDOW_HOURS=24
FALLBACK_LIMIT_SCOPE=global

# Voice is a separate application capability; engine production never depends on it.
VOICE_PROVIDER=openrouter
VOICE_MODEL=
VOICE_FALLBACK_MODEL=

# Legacy provider compatibility. Leave blank for the OpenRouter one-key profile.
MAIN_AI_PROVIDER=
MAIN_AI_API_KEY=
MAIN_AI_BASE_URL=
MAIN_AI_MODEL=
MAIN_AI_IMAGE_MODEL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_AI_MODEL=
CLOUDFLARE_AI_IMAGE_MODEL=
ERROR_AI_PROVIDER=cloudflare
ERROR_AI_API_KEY=
ERROR_AI_BASE_URL=
ERROR_AI_MODEL=

# Optional R2 adapter configuration. Automatic project mirroring is not implemented.
# REVECTOR_R2_ENDPOINT=https://YOUR_ACCOUNT.r2.cloudflarestorage.com
# REVECTOR_R2_BUCKET=revector
# REVECTOR_R2_ACCESS_KEY_ID=
# REVECTOR_R2_SECRET_ACCESS_KEY=
