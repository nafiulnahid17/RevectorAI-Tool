REVECTOR_DATA_DIR=./data
REVECTOR_MAX_UPLOAD_BYTES=52428800
REVECTOR_MAX_PIXELS=40000000
REVECTOR_WORKER_THREADS=2
REVECTOR_SYNC_JOBS=false
REVECTOR_TOOL_TIMEOUT_SECONDS=180
REVECTOR_MAX_PATHS=100000
REVECTOR_STORAGE_BACKEND=local
REVECTOR_SEGMENTATION_PROVIDER=opencv
REVECTOR_OCR_PROVIDER=tesseract
# Optional R2Storage adapter configuration. Automatic project mirroring is not implemented.
# REVECTOR_R2_ENDPOINT=https://YOUR_ACCOUNT.r2.cloudflarestorage.com
# REVECTOR_R2_BUCKET=revector
# REVECTOR_R2_ACCESS_KEY_ID=
# REVECTOR_R2_SECRET_ACCESS_KEY=

# Trusted server-side gateway authentication. Set a random value, never commit it.
REVECTOR_API_KEY=
REVECTOR_ALLOW_UNAUTHENTICATED=false

# Optional primary AI. Empty values use Cloudflare fallback immediately.
MAIN_AI_PROVIDER=
MAIN_AI_API_KEY=
MAIN_AI_BASE_URL=
MAIN_AI_MODEL=
MAIN_AI_IMAGE_MODEL=
# Cloudflare server-side fallback: vision model and reference-edit model are separate.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_AI_MODEL=
CLOUDFLARE_AI_IMAGE_MODEL=
# Advisory error assistant; uses Cloudflare token/account above unless overridden.
ERROR_AI_PROVIDER=cloudflare
ERROR_AI_API_KEY=
ERROR_AI_BASE_URL=
ERROR_AI_MODEL=
AI_TIMEOUT_SECONDS=120
REVECTOR_JOB_TIMEOUT_SECONDS=1800
